{
    "keyboard_name": "twig8",
    "manufacturer": "Twig",
    "maintainer": "nodatk",
    "usb": {
      "vid": "0xFEED",
      "pid": "0x6065",
      "device_version": "0.1.0"
    },
    "host": {
        "default": {
            "nkro": true
        }
    },
    "tapping": {
        "term": 150
    },
    "features": {
        "audio": false,
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
      "cols": ["A4", "A5", "A6", "A7"],
      "rows": ["A0", "A1"]
    },
    "diode_direction": "COL2ROW",
    "development_board": "bonsai_c4",
    "debounce": 8,
    "layouts": {
        "LAYOUT_orth_2x4": { /* I will use the board rotated */
            "layout": [
                {"matrix": [1, 3], "x": 0, "y": 0},
                {"matrix": [1, 2], "x": 1, "y": 0},
                {"matrix": [1, 1], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 3, "y": 0},

                {"matrix": [0, 3], "x": 0, "y": 1},
                {"matrix": [0, 2], "x": 1, "y": 1},
                {"matrix": [0, 1], "x": 2, "y": 1},
                {"matrix": [0, 0], "x": 3, "y": 1}
            ]
        }
    }
  }
